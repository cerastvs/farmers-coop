generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT
  MEMBER
  TREASURER
  PRESIDENT
  SECRETARY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  APPLICATION_FEE
  LOAN_PAYMENT
  EQUIPMENT_PURCHASE
  MEMBERSHIP_FEE
  OTHER_FEE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MachineStatus {
  QUEUED
  APPROVED
  IN_USE
  RETURN_PENDING
  RETURNED
  OVERDUE
  REJECTED
}

enum SupplyTransactionType {
  PURCHASE
  LOAN
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LoanType {
  SUPPLY
  MONEY
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAID
}

enum ReportType {
  SUMMARY
  MEMBERS
  LOANS
  PAYMENTS
  SUPPLIES
  MACHINES
  AUDIT
}

enum EntryType {
  ONLINE
  MANUAL
}

enum InitiatedBy {
  MEMBER
  SECRETARY
}

enum EntrySource {
  PORTAL
  OFFICE
  WALK_IN
}

model User {
  id                 String              @id @default(uuid())
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  password           String
  username           String              @unique
  role               Role                @default(APPLICANT)
  active             Boolean             @default(true)
  loans              Loan[]
  posts              Post[]
  applications       Application[]
  payments           Payment[]
  machineRequests    MachineRequest[]
  supplyTransactions SupplyTransaction[]
  availability       Availability[]
  notifications      Notification[]
  auditEntries       AuditTrail[]
  logs               Log[]
}

model Post {
  id        String  @id @default(uuid())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id])
}

model Loan {
  id                 String              @id @default(uuid())
  userId             String
  name               String              @default("Cash Loan")
  type               LoanType            @default(MONEY)
  status             LoanStatus          @default(PENDING)
  amount             Decimal             @db.Decimal(10, 2)
  termMonths         Int                 @default(6)
  purpose            String?
  createdAt          DateTime            @default(now())
  due                DateTime
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectionReason    String?
  user               User                @relation(fields: [userId], references: [id])
  payments           LoanPayment[]
  paymentSubmissions Payment[]
  statusHistory      LoanStatusHistory[]

  createdById  String?
  createdByRole Role?
  entryType    EntryType     @default(ONLINE)
  initiatedBy  InitiatedBy   @default(MEMBER)
  source       EntrySource   @default(PORTAL)
  remarks      String?
  auditId      String?
}

model Supply {
  id                      String              @id @default(uuid())
  productName             String
  price                   Decimal             @db.Decimal(10, 2)
  quantity                Int
  loanLimitPerHectare     Int?
  createdAt               DateTime            @default(now())
  transactions            SupplyTransaction[]
}

model Log {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @default("SYSTEM")
  success   Boolean  @default(true)
  info      String
  createdAt DateTime @default(now())
}

model Application {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  firstName     String
  middleName    String?
  lastName      String
  extensionName String?
  fullName      String
  age           Int
  gender        String
  address       String
  contact       String

  farmSize     Float
  cropType     String
  yearsFarming Int

  validIdUrl     String
  proofOfFarmUrl String

  status          ApplicationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
}

model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   PaymentType
  amount Decimal     @db.Decimal(10, 2)
  loanId String?
  loan   Loan?       @relation(fields: [loanId], references: [id], onDelete: SetNull)

  receiptUrl  String?
  referenceNo String?
  status      PaymentStatus @default(PENDING)

  createdAt       DateTime  @default(now())
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?

  receiptNo    String?
  createdById  String?
  createdByRole Role?
  entryType    EntryType    @default(ONLINE)
  initiatedBy  InitiatedBy  @default(MEMBER)
  source       EntrySource  @default(PORTAL)
  remarks      String?
  auditId      String?
}

model Machine {
  id          String           @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime         @default(now())
  requests    MachineRequest[]
}

model MachineRequest {
  id        String @id @default(uuid())
  userId    String
  machineId String

  user    User    @relation(fields: [userId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])

  status          MachineStatus @default(QUEUED)
  rejectionReason String?

  requestDate  DateTime  @default(now())
  startDate    DateTime?
  endDate      DateTime?
  startedAt    DateTime?
  returnedAt   DateTime?

  createdById  String?
  createdByRole Role?
  entryType    EntryType   @default(ONLINE)
  initiatedBy  InitiatedBy @default(MEMBER)
  source       EntrySource @default(PORTAL)
  remarks      String?
  auditId      String?
}

model SupplyTransaction {
  id       String @id @default(uuid())
  userId   String
  supplyId String

  user   User   @relation(fields: [userId], references: [id])
  supply Supply @relation(fields: [supplyId], references: [id])

  quantity   Int
  totalPrice Decimal @db.Decimal(10, 2)

  type            SupplyTransactionType
  status          TransactionStatus     @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  createdById  String?
  createdByRole Role?
  entryType    EntryType   @default(ONLINE)
  initiatedBy  InitiatedBy @default(MEMBER)
  source       EntrySource @default(PORTAL)
  remarks      String?
  auditId      String?
}

model LoanPayment {
  id        String  @id @default(uuid())
  loanId    String
  amount    Decimal @db.Decimal(10, 2)
  receiptNo String? // Auto-generated receipt number, e.g. RCP-2026-0001

  loan   Loan     @relation(fields: [loanId], references: [id])
  paidAt DateTime @default(now())
}

model LoanStatusHistory {
  id        String     @id @default(uuid())
  loanId    String
  loan      Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  status    LoanStatus
  changedAt DateTime   @default(now())
}

model Availability {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date     DateTime
  location String
  notes    String?

  createdAt DateTime @default(now())
}

model Report {
  id          String     @id @default(uuid())
  title       String
  type        ReportType @default(SUMMARY)
  data        Json?
  generatedBy String
  createdAt   DateTime   @default(now())
}

model AuditTrail {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
